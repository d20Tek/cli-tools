<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dev-pomo</AssemblyName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Console Pomodoro Timer</Title>
    <Description>A terminal based pomodoro timer to help manage focus time for developers.</Description>
    <PackageProjectUrl>https://github.com/d20Tek/cli-tools/tree/main/src/D20Tek.Tools.DevPomo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/d20Tek/cli-tools/tree/main/src/D20Tek.Tools.DevPomo</RepositoryUrl>
    <PackageTags>pomodoro; terminal; pomo; timer</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="D20Tek.Functional" />
    <PackageReference Include="D20Tek.Spectre.Console.Extensions" />
    <PackageReference Include="LowDb.Net.Repositories" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D20Tek.Tools.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D20Tek.Tools.Common\D20Tek.Tools.Common.csproj" />
  </ItemGroup>
</Project>
